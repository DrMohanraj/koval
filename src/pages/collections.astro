---
import BaseLayout from '../layouts/BaseLayout.astro';

const collections = [
  { title: "நிழலின் மொழிகள்", tag: "புதுக்கவிதை", cover: "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&h=520&fit=crop&q=80" },
  { title: "கையெழுத்துப் பிரதிகள்", tag: "காப்பகம்", cover: "https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=520&fit=crop&q=80" },
  { title: "வண்ணங்களின் கவிதை", tag: "காட்சிக்கலை", cover: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&h=520&fit=crop&q=80" },
  { title: "இசையின் ஆதிவேர்", tag: "நேர்காணல்", cover: "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=400&h=520&fit=crop&q=80" },
  { title: "யாழ் மீட்டும் நொடிகள்", tag: "இசை", cover: "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&h=520&fit=crop&q=80" },
  { title: "மேடைப் பேச்சு", tag: "நாடகம்", cover: "https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=400&h=520&fit=crop&q=80" },
  { title: "காலத்தின் சுவடுகள்", tag: "வரலாறு", cover: "https://images.unsplash.com/photo-1495446815901-a7297e633e8d?w=400&h=520&fit=crop&q=80" },
  { title: "புதிய வானம்", tag: "அறிவியல் புனைவு", cover: "https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=400&h=520&fit=crop&q=80" },
  { title: "மண் வாசம்", tag: "புலம்பெயர்வு", cover: "https://images.unsplash.com/photo-1455390582262-044cdead277a?w=400&h=520&fit=crop&q=80" },
  { title: "சுவடுகள்", tag: "சிறுகதை", cover: "https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=400&h=520&fit=crop&q=80" },
];
---
<BaseLayout title="தொகுப்பு - கூவல்">
<section class="px-margin-desktop py-stack-lg">
<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-stack-md">
{collections.map((item) => (
<div class="reveal active group">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-md shadow-[0_6px_16px_rgba(105,36,117,0.08)]">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src={item.cover} alt={item.title} />
<div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-primary/10 to-transparent"></div>
<div class="absolute bottom-0 left-0 right-0 p-2 text-white">
<p class="font-label-caps text-[9px] opacity-80">{item.tag}</p>
<h3 class="font-headline-md text-sm leading-tight">{item.title}</h3>
</div>
</div>
</div>
))}
</div>
</section>
</BaseLayout>

<script is:inline>
const observerOptions = { threshold: 0.1 };
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('active'); });
}, observerOptions);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
