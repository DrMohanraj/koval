---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteWall from '../components/QuoteWall.astro';

const interviews = await getCollection('interviews');
const sorted = interviews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.find((i) => i.data.featured) || sorted[0] || null;

// hero card-ல் "excerpt"-க்கு பதிலா, நேர்காணல் பக்கத்தில் வாசகர் முதலில் படிக்கும்
// முதல் கேள்வி-பதிலின் ஆரம்ப வரிகளையே (actual content preview) காட்டுதல்
function previewText(text: string, maxLen = 220) {
  if (!text) return '';
  if (text.length <= maxLen) return text;
  return text.slice(0, maxLen).trim() + '…';
}
const featuredPreview = featured?.data.qa?.[0]?.answer
  ? previewText(featured.data.qa[0].answer)
  : featured?.data.excerpt;

// Hero-இன் floating glass orb-களுக்கான 2 மேற்கோள்கள்
const heroQuotes = (featured?.data.pullQuotes && featured.data.pullQuotes.length > 0)
  ? featured.data.pullQuotes.slice(0, 2)
  : ["எழுத்து என்பது அமைதியின் இன்னொரு குரல்.", "மொழி வாழும்போது மட்டுமே நினைவுகள் வாழ்கின்றன."];
---
<BaseLayout>
  <!-- Hero Split View: இடது ஆழ்ந்த நீலம் + நடு floating portrait + வலது dark glassmorphism -->
  <section class="relative min-h-screen w-full flex flex-col lg:flex-row overflow-hidden text-white">
    <!-- இடது பாதி: ஆழ்ந்த நீலம் -->
    <div class="w-full lg:w-1/2 bg-primary min-h-[50vh] lg:min-h-screen flex flex-col justify-center px-8 sm:px-12 lg:px-16 py-16 relative z-10 reveal active">
      <div class="max-w-xl space-y-6 lg:pr-12">
        <span class="font-label-caps text-label-caps text-white/70 tracking-widest block">நேர்காணல்</span>
        {featured ? (
          <>
            <h1 class="font-display-lg-mobile lg:font-display-lg text-display-lg-mobile lg:text-display-lg font-bold leading-[1.15] text-white drop-shadow-sm">{featured.data.title}</h1>
            <p id="heroTypewriter" data-full={featuredPreview} class="font-body-lg text-body-lg text-white/85 leading-relaxed max-w-lg min-h-[110px]"></p>
            <div class="pt-2 flex items-center gap-4 flex-wrap">
              <a href={`/interview/${featured.slug}`} class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/30 font-label-caps text-label-caps px-6 py-3 rounded-full transition-all duration-300 backdrop-blur-sm no-underline group">
                <span>தொடர்ந்து படிக்க</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 group-hover:-translate-y-0.5 transition-transform">arrow_outward</span>
              </a>
              <span class="font-label-caps text-label-caps text-white/70">{featured.data.authorName}</span>
            </div>
          </>
        ) : (
          <>
            <h1 class="font-display-lg-mobile lg:font-display-lg text-display-lg-mobile lg:text-display-lg font-bold leading-[1.15] text-white">உங்கள் முதல் நேர்காணல் இங்கு தெரியும்</h1>
            <p class="font-body-lg text-body-lg text-white/85 max-w-lg">Placeholder — /admin மூலம் ஒரு நேர்காணலைச் சேர்த்தவுடன் இது தானாக இங்கு தெரியும்.</p>
          </>
        )}
      </div>
    </div>

    <!-- நடு: வட்ட வடிவ floating portrait, இரு பாதிகளின் எல்லையில் -->
    <div class="relative lg:absolute lg:left-1/2 lg:top-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2 z-20 my-8 lg:my-0 flex justify-center items-center reveal active">
      <a href={featured ? `/interview/${featured.slug}` : '/archive'} class="relative group cursor-pointer no-underline">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-white/30 to-tertiary/40 blur-md group-hover:blur-lg opacity-70 group-hover:opacity-100 transition-all duration-500"></div>
        <div class="relative w-56 h-56 sm:w-72 sm:h-72 lg:w-[340px] lg:h-[340px] rounded-full overflow-hidden border-4 border-white/80 shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]">
          <img src={featured?.data.coverImage || 'https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=800&h=1000&fit=crop&q=80'}
               alt={featured?.data.authorName || 'Portrait'}
               class="w-full h-full object-cover object-center filter grayscale contrast-125 group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-6 text-center">
            <span class="font-headline-md text-lg text-white font-bold mb-1">{featured?.data.authorName}</span>
            <span class="text-xs text-white/80 font-label-caps tracking-widest uppercase">நேர்காணலைப் படிக்க →</span>
          </div>
        </div>
      </a>
    </div>

    <!-- வலது பாதி: Dark glassmorphism, மிதக்கும் glass orb மேற்கோள்கள் -->
    <div class="w-full lg:w-1/2 bg-[#0F1E2E] min-h-[50vh] lg:min-h-screen flex flex-col justify-between px-8 sm:px-12 lg:px-16 py-12 lg:py-16 relative z-10 lg:pl-36 reveal active">
      <div class="flex flex-col space-y-6 lg:space-y-8 my-auto pt-6 lg:pt-0">
        <div class="glass-orb animate-float rounded-full w-full max-w-sm lg:max-w-[340px] p-6 sm:p-8 text-center transition-all duration-300 hover:scale-[1.03] mx-auto lg:ml-auto">
          <blockquote class="font-headline-md text-sm lg:text-base text-white/95 leading-relaxed italic font-light">"{heroQuotes[0]}"</blockquote>
        </div>
        {heroQuotes[1] && (
          <div class="glass-orb animate-float-delayed rounded-full w-full max-w-sm lg:max-w-[380px] p-6 sm:p-8 text-center transition-all duration-300 hover:scale-[1.03] mx-auto lg:mr-auto">
            <blockquote class="font-headline-md text-sm lg:text-base text-white/95 leading-relaxed italic font-light">"{heroQuotes[1]}"</blockquote>
          </div>
        )}
      </div>

      <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 max-w-lg">
        <div class="space-y-1">
          <h3 class="font-headline-md text-lg font-semibold tracking-wide text-white">Join the Dialogue</h3>
          <p class="font-caption text-xs text-white/60 max-w-xs">மாதாந்திர கட்டுரைகள், தனிச்சிறப்பு நேர்காணல்கள் உங்கள் இன்பாக்ஸில்.</p>
        </div>
        <a href="/newsletter" class="bg-white text-primary hover:bg-white/90 font-label-caps font-medium text-xs py-2.5 px-6 rounded-full transition-all duration-200 whitespace-nowrap shadow-md hover:scale-105 no-underline">சேருங்கள்</a>
      </div>
    </div>
  </section>

  <div class="flex items-center justify-center py-stack-lg reveal active">
    <div class="h-[1px] w-1/4 bg-outline-variant"></div>
    <span class="material-symbols-outlined text-secondary mx-8" style="font-variation-settings: 'FILL' 1;">spa</span>
    <div class="h-[1px] w-1/4 bg-outline-variant"></div>
  </div>

  <QuoteWall />
</BaseLayout>

<script is:inline>
  // Hero-ல் முதல் paragraph-ஐ typewriter ink-reveal ஆக (எழுதுவது போல்) காட்டுதல்
  (function () {
    const el = document.getElementById('heroTypewriter');
    if (!el) return;
    const fullText = el.getAttribute('data-full') || '';
    let i = 0;
    function type() {
      if (i <= fullText.length) {
        el.textContent = fullText.slice(0, i);
        i++;
        setTimeout(type, 22);
      }
    }
    // சிறிது தாமதத்துடன் ஆரம்பித்தல் (hero-இன் மற்ற reveal animation முடிந்த பிறகு)
    setTimeout(type, 400);
  })();
</script>
