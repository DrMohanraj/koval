---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="தலையங்கம் - கூவல்">
<!-- Page Header -->
<header class="text-center mb-24 reveal">
<span class="font-label-caps text-label-caps text-secondary mb-4 block tracking-widest">ஆசிரியர் உரை</span>
<h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary italic font-bold">
                காலத்தின் குரல்
            </h1>
<div class="w-24 h-px bg-outline-variant mx-auto mt-8"></div>
</header>
<!-- Main Content Canvas -->
<article class="space-y-stack-lg text-on-surface-variant reveal">
<p class="drop-cap font-body-lg text-body-lg mb-12">
                இலக்கியம் என்பது வெறும் சொற்களின் தொகுப்பல்ல; அது ஒரு சமூகத்தின் ஆன்மா. கூவல் இதழின் இந்த புதிய இதழை உங்கள் கைகளில் ஒப்படைப்பதில் நாங்கள் பெருமிதம் கொள்கிறோம். நவீன உலகின் வேகமான ஓட்டத்தில், நம் வேர்களைத் தேடிச் செல்லும் ஒரு பயணமாகவே இதைக் கருதுகிறோம். கலையும் இலக்கியமும் மனித நேயத்தின் உச்சபட்ச வெளிப்பாடுகள். இந்த இதழில் நாம் கையாண்டுள்ள தலைப்புகள் ஒவ்வொன்றும், நம் காலத்தின் மாற்றங்களையும், அந்த மாற்றங்களுக்கு இடையே நிலைத்து நிற்கும் பண்பாட்டு விழுமியங்களையும் படம் பிடித்துக் காட்டுகின்றன.
            </p>
<p class="font-body-lg text-body-lg leading-relaxed">
                ஒவ்வொரு படைப்பும் ஒரு உரையாடல். படைப்பாளிக்கும் வாசகனுக்கும் இடையிலான இந்த நுட்பமான பிணைப்புதான் இலக்கியத்தைத் தொடர்ந்து உயிர்ப்புடன் வைத்திருக்கிறது. கூவல் வெறும் இதழாக மட்டும் இல்லாமல், ஒரு திறந்த விவாத மேடையாகவும், புதிய சிந்தனைகளின் களமாகவும் இருக்க வேண்டும் என்பதே எமது நோக்கம்.
            </p>
<div class="py-12 flex justify-center">
<div class="w-full h-96 relative rounded-xl overflow-hidden group">
<img class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" data-alt="A serene, high-end editorial photography of a single lavender sprig resting on an old, open Tamil manuscript. The lighting is soft morning sunlight casting long, delicate shadows on a warm cream-colored textured paper. The composition is minimalist and cinematic, evoking a sense of scholarly calm and botanical luxury, consistent with a premium literary magazine aesthetic." src="https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=400&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent"></div>
</div>
</div>
<p class="font-body-lg text-body-lg leading-relaxed italic border-l-4 border-primary/20 pl-8 my-12">
                "சிறந்த இலக்கியம் என்பது நாம் ஏற்கனவே அறிந்த உண்மைகளை புதிய வெளிச்சத்தில் காண்பிப்பதே."
            </p>
<p class="font-body-lg text-body-lg leading-relaxed">
                இந்த இதழில் இடம்பெற்றுள்ள நேர்காணல்கள், கட்டுரைகள் மற்றும் கவிதைகள் யாவும் உங்கள் சிந்தனையைத் தூண்டும் என நம்புகிறோம். குறிப்பாக, திராவிடக் கலைகளின் நவீன வடிவம் குறித்த சிறப்புக் கட்டுரை, நம் பாரம்பரியத்தின் தொடர்ச்சியைப் புரிந்துகொள்ள உதவும். தொடர்ந்து ஆதரவு தரும் வாசகர்களுக்கும், தங்களின் அரிய படைப்புகளை வழங்கிய கலைஞர்களுக்கும் எமது மனமார்ந்த நன்றிகள்.
            </p>
</article>
<!-- Signature Block -->
<section class="mt-24 border-t border-outline-variant/30 pt-12 reveal">
<div class="flex flex-col md:flex-row justify-between items-end">
<div class="space-y-2">
<p class="font-caption text-caption text-secondary">அன்புடன்,</p>
<p class="font-headline-md text-headline-md text-primary italic">செந்தாமரை செல்வன்</p>
<p class="font-label-caps text-label-caps text-on-surface-variant">முதன்மை ஆசிரியர், கூவல்</p>
</div>
<div class="mt-8 md:mt-0 flex items-center gap-4">
<div class="w-16 h-16 text-on-tertiary-container">
<span class="material-symbols-outlined text-[64px]" style="font-variation-settings: 'FILL' 1;">spa</span>
</div>
</div>
</div>
</section>
</BaseLayout>

<script is:inline>
// Scroll Reveal Interaction
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Hover lift and tilt effect on article image
        const articleImg = document.querySelector('.group');
        if (articleImg) {
            articleImg.addEventListener('mousemove', (e) => {
                const { left, top, width, height } = articleImg.getBoundingClientRect();
                const x = (e.clientX - left) / width;
                const y = (e.clientY - top) / height;
                const rotateX = (y - 0.5) * 2;
                const rotateY = (x - 0.5) * -2;
                articleImg.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
            });
            articleImg.addEventListener('mouseleave', () => {
                articleImg.style.transform = 'none';
            });
        }
</script>
