---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews');
  return interviews.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allInterviews: interviews },
  }));
}

const { entry, allInterviews } = Astro.props;
const { title, authorName, authorRole, authorPhoto, coverImage, category, date, qa, pullQuotes } = entry.data;

// prev/next — தேதி வரிசைப்படி
const sorted = [...allInterviews].sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const currentIndex = sorted.findIndex((e) => e.slug === entry.slug);
const prevEntry = sorted[currentIndex + 1] || null;
const nextEntry = sorted[currentIndex - 1] || null;

// சுமார் வாசிப்பு நேரம் — mots count அடிப்படையில்
const totalWords = (qa || []).reduce(
  (sum, item) => sum + (item.answer ? item.answer.split(/\s+/).length : 0),
  0
);
const readingMinutes = Math.max(1, Math.round(totalWords / 160));

const heroImage = coverImage || null;
const heroQuote = pullQuotes && pullQuotes.length > 0 ? pullQuotes[0] : null;
const remainingQuotes = pullQuotes && pullQuotes.length > 1 ? pullQuotes.slice(1) : [];

const dateFormatted = new Date(date).toLocaleDateString('ta-IN', {
  year: 'numeric', month: 'long',
});
---
<BaseLayout title={title}>
  <div id="progress-track"><div id="progress-fill"></div></div>

  <div class="topbar">
    <div class="topbar-left">
      <span class="brand-mark">கூவல்</span>
      <span>·</span>
      <span>{category}</span>
    </div>
    <div class="topbar-icons">
      <button class="icon-btn" title="Bookmark" aria-label="Bookmark">🔖</button>
      <button class="icon-btn" id="shareBtn" title="Share" aria-label="Share">↗</button>
    </div>
  </div>

  <div class="hero-wrap">
    <section class="hero">
      <div class="hero-image" style={heroImage ? `background-image:url('${heroImage}'); background-size:cover; background-position:center;` : ''}>
        <span class="caption-chip">{authorRole || 'Portrait'} · Placeholder</span>
      </div>
      <div class="hero-copy">
        <div class="chapter-num">நேர்காணல் · {category}</div>
        <h1>{title}</h1>
        {entry.data.excerpt && <p class="hero-dek">{entry.data.excerpt}</p>}
        <div class="hero-meta">
          <div class="avatar" style={authorPhoto ? `background-image:url('${authorPhoto}'); background-size:cover;` : ''}></div>
          <div>
            <div style="font-weight:600;color:var(--charcoal);">{authorName}</div>
            <div>சுமார் {readingMinutes} நிமிட வாசிப்பு · {dateFormatted}</div>
          </div>
        </div>
      </div>
    </section>
  </div>

  {heroQuote && (
    <section class="spread">
      <div class="lead-col">
        <div class="drop-line"></div>
        {qa && qa[0] && <p>{qa[0].answer}</p>}
      </div>
      <div>
        <div class="oversized-quote">
          <span class="highlight-chip">முக்கிய மேற்கோள்</span>
          <span class="mark">"</span>
          <p>{heroQuote}</p>
          <div class="attrib">— {authorName}, {authorRole}</div>
        </div>
      </div>
    </section>
  )}

  <div class="chapter-divider">
    <span>உரையாடல் தொடர்கிறது</span>
    <div class="line"></div>
  </div>

  <section class="qa-spread">
    {qa && qa.slice(heroQuote ? 1 : 0).map((item, i) => (
      <>
        <div class="qa-item">
          <div class="qnum">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <p class="q-text">{item.question}</p>
            <p class="a-text">{item.answer}</p>
          </div>
        </div>
        {remainingQuotes[i] && (
          <div class="mid-quote">
            <span class="mark">"</span>
            <p>{remainingQuotes[i]}</p>
          </div>
        )}
      </>
    ))}
  </section>

  <div class="bottom-nav">
    {prevEntry ? (
      <a class="nav-card" href={`/interview/${prevEntry.slug}`}>
        <div class="dir">← முந்தைய நேர்காணல்</div>
        <div class="title">{prevEntry.data.title}</div>
      </a>
    ) : <div />}
    {nextEntry ? (
      <a class="nav-card next" href={`/interview/${nextEntry.slug}`}>
        <div class="dir">அடுத்த நேர்காணல் →</div>
        <div class="title">{nextEntry.data.title}</div>
      </a>
    ) : <div />}
  </div>
</BaseLayout>

<style>
  :root{
    --blue-deep:#1B4D91;
    --blue-med:#4F7FBF;
    --sage:#82AB7D;
    --olive:#6A6B4E;
    --cream:#FBF8F2;
    --paper:#F3EDE0;
    --charcoal:#1A2938;
    --border:#E3D8C6;
  }

  #progress-track{
    position:fixed; top:0; left:0; height:2px; width:100%;
    background:rgba(0,0,0,.05); z-index:51;
  }
  #progress-fill{
    height:100%; width:0%;
    background:linear-gradient(90deg,var(--blue-deep),var(--sage));
    transition:width .1s linear;
  }

  .topbar{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 32px;
    background:rgba(251,248,242,.75);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid rgba(227,216,198,.7);
  }
  .topbar-left{ display:flex; align-items:center; gap:14px; font-family:'Manrope',sans-serif; font-size:12px; color:var(--olive); }
  .brand-mark{ font-family:'Bodoni Moda',serif; font-weight:600; font-size:16px; color:var(--blue-deep); }
  .topbar-icons{ display:flex; align-items:center; gap:18px; }
  .icon-btn{
    width:34px; height:34px; border-radius:50%;
    background:rgba(255,255,255,.6); border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:.25s; font-size:14px; color:var(--blue-deep);
  }
  .icon-btn:hover{ background:var(--blue-deep); color:#fff; }

  .hero-wrap{ max-width:920px; margin:36px auto 0; padding:0 24px; }
  .hero{
    position:relative; height:400px; border-radius:26px; overflow:hidden;
    display:grid; grid-template-columns:1fr 1fr; align-items:stretch;
    box-shadow:0 24px 60px -24px rgba(27,77,145,.35);
  }
  .hero-image{
    position:relative;
    background: linear-gradient(180deg, rgba(26,41,56,.05), rgba(26,41,56,.55)), linear-gradient(140deg, #2c4a6e, #1B4D91 45%, #0e2c50);
  }
  .hero-image .caption-chip{
    position:absolute; bottom:20px; left:20px;
    font-family:'Manrope',sans-serif; font-size:9.5px; letter-spacing:.08em;
    text-transform:uppercase; color:#fff; background:rgba(0,0,0,.35);
    backdrop-filter:blur(6px); padding:5px 12px; border-radius:999px;
  }
  .hero-copy{
    display:flex; flex-direction:column; justify-content:center;
    padding:28px 30px; position:relative; background:var(--paper);
  }
  .chapter-num{ font-family:'Manrope',sans-serif; font-size:9.5px; letter-spacing:.15em; color:var(--sage); font-weight:700; margin-bottom:10px; }
  .hero-copy h1{ font-family:'Noto Serif Tamil',serif; font-weight:800; font-size:22px; line-height:1.35; color:var(--blue-deep); margin:0 0 12px; }
  .hero-dek{ font-family:'Catamaran',sans-serif; font-size:12.5px; line-height:1.6; color:var(--olive); max-width:320px; margin-bottom:16px; }
  .hero-meta{ display:flex; align-items:center; gap:10px; font-family:'Manrope',sans-serif; font-size:10px; color:var(--olive); }
  .hero-meta .avatar{ width:28px; height:28px; border-radius:50%; background:linear-gradient(140deg,var(--blue-med),var(--blue-deep)); background-size:cover; }

  .spread{
    max-width:1180px; margin:0 auto; padding:80px 32px 40px;
    display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start;
  }
  .lead-col{ padding-top:20px; }
  .drop-line{ width:48px; height:2px; background:var(--sage); margin-bottom:24px; }
  .lead-col p{ font-family:'Catamaran',sans-serif; font-size:18px; line-height:1.85; color:var(--charcoal); }
  .lead-col p::first-letter{ font-family:'Bodoni Moda',serif; font-size:56px; font-weight:600; color:var(--blue-deep); float:left; line-height:.75; margin:6px 10px 0 0; }

  .oversized-quote{
    position:relative; background:rgba(255,255,255,.55); backdrop-filter:blur(10px);
    border:1px solid rgba(227,216,198,.9); border-radius:22px; padding:44px 38px;
  }
  .oversized-quote .mark{ font-family:'Bodoni Moda',serif; font-style:italic; font-size:56px; color:var(--blue-med); line-height:.5; display:block; margin-bottom:14px; opacity:.8; }
  .oversized-quote p{ font-family:'Noto Serif Tamil',serif; font-weight:700; font-size:26px; line-height:1.45; color:var(--blue-deep); margin:0 0 18px; }
  .oversized-quote .attrib{ font-family:'Manrope',sans-serif; font-size:11.5px; color:var(--olive); }
  .oversized-quote .highlight-chip{
    position:absolute; top:-14px; right:24px; font-family:'Manrope',sans-serif; font-size:10px; font-weight:700;
    letter-spacing:.05em; text-transform:uppercase; background:var(--sage); color:#fff; padding:5px 12px; border-radius:999px;
  }

  .chapter-divider{ max-width:1180px; margin:60px auto 40px; padding:0 32px; display:flex; align-items:center; gap:18px; }
  .chapter-divider .line{ flex:1; height:1px; background:var(--border); }
  .chapter-divider span{ font-family:'Manrope',sans-serif; font-size:11px; letter-spacing:.15em; text-transform:uppercase; color:var(--sage); font-weight:700; }

  .qa-spread{ max-width:900px; margin:0 auto; padding:0 32px 60px; }
  .qa-item{ display:grid; grid-template-columns:44px 1fr; gap:22px; margin-bottom:52px; padding-bottom:52px; border-bottom:1px solid var(--border); }
  .qnum{ font-family:'Bodoni Moda',serif; font-style:italic; font-weight:600; font-size:26px; color:var(--sage); }
  .q-text{ font-family:'Noto Serif Tamil',serif; font-weight:700; font-size:21px; line-height:1.6; color:var(--blue-deep); margin:0 0 16px; }
  .a-text{ font-family:'Catamaran',sans-serif; font-size:16.5px; line-height:1.85; color:var(--charcoal); margin:0; white-space:pre-line; }

  .mid-quote{
    max-width:820px; margin:0 auto 52px; padding:28px 30px;
    background:linear-gradient(155deg,#EBDCF3,#D3B0E3); border:1px solid #C295D9; border-radius:14px;
  }
  .mid-quote p{ font-family:'Noto Serif Tamil',serif; font-weight:600; font-size:19px; line-height:1.6; color:var(--charcoal); margin:0; }

  .bottom-nav{ max-width:1180px; margin:0 auto; padding:40px 32px 100px; display:flex; justify-content:space-between; gap:20px; }
  .nav-card{ flex:1; padding:24px; border-radius:16px; background:rgba(255,255,255,.6); border:1px solid var(--border); font-family:'Manrope',sans-serif; text-decoration:none; display:block; transition:.25s; }
  .nav-card:hover{ border-color:var(--blue-med); }
  .nav-card .dir{ font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--sage); font-weight:700; margin-bottom:8px; }
  .nav-card .title{ font-family:'Noto Serif Tamil',serif; font-size:16px; color:var(--blue-deep); font-weight:700; }
  .nav-card.next{ text-align:right; }

  @media(max-width:900px){
    .hero{ grid-template-columns:1fr; height:auto; }
    .hero-image{ height:180px; }
    .hero-copy{ padding:24px 22px; }
    .hero-copy h1{ font-size:19px; }
    .spread{ grid-template-columns:1fr; padding-top:60px; }
    .oversized-quote p{ font-size:22px; }
    .bottom-nav{ flex-direction:column; }
  }
</style>

<script is:inline>
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
    const fill = document.getElementById('progress-fill');
    if (fill) fill.style.width = scrolled + '%';
  });

  const shareBtn = document.getElementById('shareBtn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try { await navigator.share({ title: document.title, url: window.location.href }); }
        catch (e) {}
      } else {
        navigator.clipboard.writeText(window.location.href);
      }
    });
  }
</script>
