---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ஆசிரியர் விவரம் - கூவல்">
<!-- Main Profile Layout -->
<div class="max-w-screen-2xl mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
<!-- Left Side: Large Portrait -->
<div class="lg:col-span-5 sticky top-32 reveal">
<div class="relative group">
<div class="aspect-[4/5] overflow-hidden rounded-xl shadow-xl shadow-primary/5">
<img class="w-full h-full object-cover grayscale-[20%] group-hover:scale-105 transition-transform duration-700" data-alt="A sophisticated editorial portrait of a Tamil literary scholar, an elderly man with thoughtful eyes and silver hair, wearing a crisp traditional white veshti and shirt. He is sitting in a sun-drenched library with blurred shelves of ancient Tamil palm-leaf manuscripts in the background. The lighting is soft and cinematic, emphasizing a warm cream and sage green botanical luxury aesthetic with a high-end magazine feel." src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&h=400&fit=crop&q=80"/>
</div>
<!-- Abstract Botanical Ornament -->
<div class="absolute -bottom-10 -right-10 w-40 h-40 opacity-20 pointer-events-none">
<svg class="text-on-tertiary-container fill-current" fill="none" viewbox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
<path d="M100 0C100 55.2285 55.2285 100 0 100C55.2285 100 100 144.772 100 200C100 144.772 144.772 100 200 100C144.772 100 100 55.2285 100 0Z"></path>
</svg>
</div>
</div>
</div>
<!-- Right Side: Content -->
<div class="lg:col-span-7 space-y-section-gap pt-stack-lg lg:pt-0">
<!-- Bio Section -->
<section class="reveal">
<div class="mb-stack-md">
<span class="font-label-caps text-label-caps text-secondary tracking-widest block mb-2">FOUNDING EDITOR</span>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary leading-tight">அரவிந்தன் <br/> நீலகண்டன்</h1>
</div>
<div class="max-w-2xl">
<p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg italic leading-relaxed">
                                "இலக்கியம் என்பது காலத்தின் கண்ணாடி மட்டுமல்ல, அது காலத்தைக் கடந்த தேடலின் குரலும் கூட."
                            </p>
<p class="font-body-md text-body-md text-on-surface-variant leading-loose mb-stack-lg">
                                கடந்த இருபது ஆண்டுகளாக தமிழ் இலக்கியப் பரப்பில் இயங்கி வரும் அரவிந்தன், 'கூவல்' இதழின் நிறுவன ஆசிரியர். பழம்பெரும் இலக்கியங்களையும் நவீனக் கோட்பாடுகளையும் இணைக்கும் பாலமாக இவரது எழுத்துக்கள் அமைகின்றன. பல உலகளாவிய இலக்கியச் சந்திப்புகளில் தமிழ்ப் பிரதிநிதியாகப் பங்கேற்றுள்ளார். 
                            </p>
<div class="flex flex-wrap gap-stack-md items-center py-stack-lg border-y border-outline-variant/30">
<button class="bg-primary text-on-primary px-8 py-3 rounded-full font-label-caps text-label-caps hover:shadow-lg hover:shadow-primary/20 transition-all active:scale-95">
                                    FOLLOW
                                </button>
<div class="flex gap-stack-md ml-4">
<a class="w-10 h-10 flex items-center justify-center rounded-full border border-outline-variant hover:bg-secondary-container transition-colors" href="https://instagram.com" target="_blank" rel="noopener">
<span class="material-symbols-outlined text-primary text-[20px]">public</span>
</a>
<a class="w-10 h-10 flex items-center justify-center rounded-full border border-outline-variant hover:bg-secondary-container transition-colors" href="https://instagram.com" target="_blank" rel="noopener">
<span class="material-symbols-outlined text-primary text-[20px]">mail</span>
</a>
<a class="w-10 h-10 flex items-center justify-center rounded-full border border-outline-variant hover:bg-secondary-container transition-colors" href="https://instagram.com" target="_blank" rel="noopener">
<span class="material-symbols-outlined text-primary text-[20px]">share</span>
</a>
</div>
</div>
</div>
</section>
<!-- Published Works Section -->
<section class="space-y-stack-lg reveal">
<div class="flex justify-between items-end border-b border-outline-variant/50 pb-stack-sm">
<h2 class="font-headline-md text-headline-md text-on-surface">சமீபத்திய படைப்புகள்</h2>
<a class="font-label-caps text-label-caps text-primary hover:underline" href="/archive">VIEW ALL</a>
</div>
<div class="grid grid-cols-1 gap-gutter">
<!-- Article Card 1 -->
<div class="group tilt-card bg-surface-container-low p-stack-lg rounded-xl flex gap-stack-lg items-center shadow-sm">
<div class="w-24 h-32 flex-shrink-0 bg-surface-container-high rounded overflow-hidden">
<img class="w-full h-full object-cover" data-alt="Close up photography of an old Tamil leather-bound book lying on a sage green silk cloth, soft morning light hitting the golden embossed letters on the spine. Botanical luxury aesthetic, high-end editorial style, depth of field." src="https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1200&h=675&fit=crop&q=80"/>
</div>
<div class="flex-grow">
<span class="font-label-caps text-[10px] text-tertiary-container bg-on-tertiary-container/10 px-2 py-0.5 rounded-full">INTERVIEW</span>
<h3 class="font-headline-md text-2xl text-primary mt-2 group-hover:text-secondary transition-colors cursor-pointer">நவீனக் கவிதைகளில் தொன்மங்களின் தாக்கம்</h3>
<p class="text-caption font-caption text-on-surface-variant mt-1">மார்ச் 12, 2024 • 12 நிமிடம் வாசிப்பு</p>
</div>
<span class="material-symbols-outlined text-outline group-hover:text-primary transition-transform group-hover:translate-x-1">arrow_forward</span>
</div>
<!-- Article Card 2 -->
<div class="group tilt-card bg-surface-container-low p-stack-lg rounded-xl flex gap-stack-lg items-center shadow-sm">
<div class="w-24 h-32 flex-shrink-0 bg-surface-container-high rounded overflow-hidden">
<img class="w-full h-full object-cover" data-alt="Artistic macro shot of a single drop of ink falling into clear water, creating smoky purple and sage green plumes, representing literary inspiration. Editorial style, botanical luxury color palette, soft focus background." src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=1200&h=675&fit=crop&q=80"/>
</div>
<div class="flex-grow">
<span class="font-label-caps text-[10px] text-tertiary-container bg-on-tertiary-container/10 px-2 py-0.5 rounded-full">COLLECTION</span>
<h3 class="font-headline-md text-2xl text-primary mt-2 group-hover:text-secondary transition-colors cursor-pointer">சங்க இலக்கியத்தின் நிலப்பரப்பு சார் அரசியல்</h3>
<p class="text-caption font-caption text-on-surface-variant mt-1">பிப்ரவரி 28, 2024 • 8 நிமிடம் வாசிப்பு</p>
</div>
<span class="material-symbols-outlined text-outline group-hover:text-primary transition-transform group-hover:translate-x-1">arrow_forward</span>
</div>
<!-- Article Card 3 -->
<div class="group tilt-card bg-surface-container-low p-stack-lg rounded-xl flex gap-stack-lg items-center shadow-sm">
<div class="w-24 h-32 flex-shrink-0 bg-surface-container-high rounded overflow-hidden">
<img class="w-full h-full object-cover" data-alt="Minimalist top view of a writing desk with a classic fountain pen, a small ceramic pot of lavender, and an open notebook with elegant Tamil calligraphy. Calm light-mode background, sophisticated refined botanical look." src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=800&h=1000&fit=crop&q=80"/>
</div>
<div class="flex-grow">
<span class="font-label-caps text-[10px] text-tertiary-container bg-on-tertiary-container/10 px-2 py-0.5 rounded-full">ESSAY</span>
<h3 class="font-headline-md text-2xl text-primary mt-2 group-hover:text-secondary transition-colors cursor-pointer">மொழியாக்கத்தின் சவால்களும் சாத்தியங்களும்</h3>
<p class="text-caption font-caption text-on-surface-variant mt-1">ஜனவரி 15, 2024 • 15 நிமிடம் வாசிப்பு</p>
</div>
<span class="material-symbols-outlined text-outline group-hover:text-primary transition-transform group-hover:translate-x-1">arrow_forward</span>
</div>
</div>
</section>
<!-- Awards/Recognition -->
<section class="reveal">
<div class="bg-primary/5 p-stack-lg rounded-xl border-l-4 border-primary">
<h4 class="font-label-caps text-label-caps text-primary mb-4">RECOGNITIONS</h4>
<ul class="space-y-stack-sm text-body-md text-on-surface-variant">
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-[16px] text-secondary" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                                    சிறந்த இலக்கிய ஆய்வாளர் விருது - 2022
                                </li>
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-[16px] text-secondary" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                                    வாழ்நாள் இலக்கியச் சாதனையாளர் விருது - 2020
                                </li>
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-[16px] text-secondary" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                                    ஆண்டுப் படைப்பாளர் - தமிழ் வளர்ச்சித் துறை
                                </li>
</ul>
</div>
</section>
</div>
</div>
</div>
</BaseLayout>

<script is:inline>
// Scroll Reveal Logic
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Interaction scale effect
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.classList.add('scale-95'));
            el.addEventListener('mouseup', () => el.classList.remove('scale-95'));
            el.addEventListener('mouseleave', () => el.classList.remove('scale-95'));
        });
</script>
